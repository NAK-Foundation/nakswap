type HelperResult = 
 variant {
   busy;
   dirty: record {
            icp: nat;
            nak: nat;
          };
   done:
    record {
      clean: bool;
      icpReturned: nat;
      nakReturned: nat;
      note: text;
      pulled: bool;
      swapped: bool;
    };
   notAuthorized;
 };
type HelperJob = 
 record {
   amountIn: nat;
   from: Account;
   icpFee: nat;
   minOut: nat;
   nakFee: nat;
   pull: nat;
   returnTo: Account;
   strayTo: Account;
   zeroForOne: bool;
 };
type Helper = 
 service {
   health: () -> (record {
                    busy: bool;
                    cycles: nat;
                    lastClean: bool;
                  }) query;
   poolUnused: () -> (variant {
                        err: text;
                        ok: record {
                              icp: nat;
                              nak: nat;
                            };
                      });
   returnAll: (to: Account, nakFee: nat, icpFee: nat) ->
    (variant {
       err: text;
       ok: record {
             icp: nat;
             nak: nat;
           };
     });
   routerId: () -> (principal) query;
   settled: (icpFee: nat, nakFee: nat) -> (bool);
   swap: (job: HelperJob) -> (HelperResult);
   withdrawFromPool: (icpToken: bool, amount: nat, fee: nat) ->
    (variant {
       err: text;
       ok: nat;
     });
 };
type Account = 
 record {
   owner: principal;
   subaccount: opt blob;
 };
service : (router: principal, icpLedger: principal, nakLedger: principal, pool: principal, icpIsToken0: bool) -> Helper
