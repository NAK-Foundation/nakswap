type Status = 
 variant {
   awaitingDeposit;
   completed: record {
                block: nat;
                icpIn: nat;
                nakOut: nat;
              };
   expired;
   needsReview: text;
   payoutPending: record {
                    createdAtTime: nat64;
                    icpIn: nat;
                    nakAmount: nat;
                  };
   refundPending:
    record {
      createdAtTime: nat64;
      fromDeposit: bool;
      icpAmount: nat;
      reason: RefundReason;
    };
   refunded: record {
               block: nat;
               icpAmount: nat;
               reason: RefundReason;
             };
   swapping: record {
               icpIn: nat;
               startedAt: int;
             };
 };
type Router = 
 service {
   activeOrderIds: () -> (vec nat) query;
   addGuardian: (p: principal) -> (bool);
   adminOverview: () -> (opt Overview) query;
   attachHoudini: (id: nat, houdiniId: text) -> (bool);
   auditRequests: () -> (vec record {
                               at: int;
                               id: nat;
                               note: text;
                             }) query;
   cancelUnfunded: (id: nat) -> (bool);
   checkLateDeposits: () -> (nat);
   clearHelper: (i: nat) -> (bool);
   createOrder: (args: CreateOrderArgs) -> (Result_7);
   dustPayoutInfo: () -> (DustPayoutInfo) query;
   feeStatus: () -> (FeeStatus) query;
   forcePayout: (id: nat, nakAmount: nat, fromDeposit: bool) -> (opt Status);
   forceRefund: (id: nat, icpAmount: nat, fromDeposit: bool) -> (opt Status);
   getConfig: () -> (Config) query;
   getOrder: (id: nat) -> (opt OrderView) query;
   guardians: () -> (vec principal) query;
   health: () -> (Health) query;
   helperPoolUnused: (i: nat) -> (Result_1);
   helperRecover: (i: nat, id: opt nat) -> (Result_1);
   helperWithdrawFromPool: (i: nat, icpToken: bool, amount: nat) -> (Result);
   helpers: () -> (vec HelperInfo) query;
   listOrders: (fromId: nat, limit: nat) -> (vec OrderView) query;
   myRole: () -> (Role) query;
   poke: (id: nat) -> (PokeResult);
   poolUnusedBalance: () -> (Result_1);
   publicStats: () ->
    (record {
       icpSwapped: nat;
       lateWatched: nat;
       nakDelivered: nat;
       swaps: nat;
     }) query;
   publicStatus: () ->
    (record {
       acceptingOrders: bool;
       cycles: nat;
       helpers: nat;
       maxOpenOrders: nat;
       needsReview: nat;
       openOrders: nat;
       ordersLastHour: nat;
       ordersWithHelperFunds: nat;
       paused: bool;
       quarantinedHelpers: nat;
       stuckFees: nat;
     }) query;
   recoverDeposit: (id: nat, to: principal) -> (Result_1);
   recoverStray: (to: principal) -> (Result_1);
   removeGuardian: (p: principal) -> (bool);
   reopen: (id: nat) -> (opt Status);
   requestAudit: (note: text) -> (opt nat);
   resolveStuckFees: (delivered: bool) -> (bool);
   runRecovery: () -> ();
   setConfig: (cfg: Config) -> (bool);
   setDustPayout: (to: opt principal, minIcp: nat) -> (bool);
   setFee: (bps: nat, to: principal) -> (bool);
   setHelpers: (list: vec principal, moduleHash: blob) -> (bool);
   setPaused: (paused: bool) -> (bool);
   sweepFees: () -> (nat);
   sweepOrderDust: (id: nat) -> (Result_1);
   withdrawFromPool: (icpToken: bool, amount: nat) -> (Result);
 };
type Role = 
 variant {
   admin;
   controller;
   guardian;
   none;
   operator;
 };
type Result_7 = 
 variant {
   err: CreateOrderError;
   ok: OrderView;
 };
type Result_1 = 
 variant {
   err: text;
   ok: record {
         icp: nat;
         nak: nat;
       };
 };
type Result = 
 variant {
   err: text;
   ok: nat;
 };
type RefundReason = 
 variant {
   admin;
   priceImpact: record {bps: nat;};
   swapFailed: text;
   tooLarge;
   tooSmall;
 };
type PokeResult = 
 variant {
   busy;
   notAuthorized;
   notFound;
   processed: Status;
   tooSoon;
 };
type Overview = 
 record {
   counts: vec record {
                 text;
                 nat;
               };
   fees: FeeStatus;
   health: Health;
   helpers: vec HelperInfo;
   maxOpenOrders: nat;
   ordersLastHour: nat;
   ordersWithHelperFunds: nat;
   recent: vec OrderLine;
   review: vec OrderLine;
   straySubaccount: blob;
 };
type OrderView = 
 record {
   createdAt: int;
   depositAccountId: text;
   depositSubaccount: blob;
   houdiniId: opt text;
   id: nat;
   minNakOut: nat;
   recipient: principal;
   refundTo: principal;
   status: Status;
 };
type OrderLine = 
 record {
   createdAt: int;
   detail: text;
   icpIn: nat;
   id: nat;
   nakOut: nat;
   status: text;
 };
type HelperInfo = 
 record {
   busy: bool;
   helper: principal;
   holdsOrder: opt nat;
   quarantined: bool;
 };
type Health = 
 record {
   acceptingOrders: bool;
   activeOrders: nat;
   cycles: nat;
   feeBps: nat;
   helpers: nat;
   lowCyclesThreshold: nat;
   nextOrderId: nat;
   paused: bool;
 };
type FeeSweep = 
 record {
   amount: nat;
   createdAtTime: nat64;
   gross: nat;
   to: principal;
 };
type FeeStatus = 
 record {
   accrued: nat;
   autoSweepAt: nat;
   bps: nat;
   paidTotal: nat;
   pending: opt FeeSweep;
   stuck: nat;
   to: principal;
 };
type DustPayoutInfo = 
 record {
   minIcp: nat;
   to: opt principal;
 };
type CreateOrderError = 
 variant {
   anonymousRecipient;
   invalidRecipient;
   notAuthorized;
   paused;
   tooManyOpenOrders;
 };
type CreateOrderArgs = 
 record {
   minNakOut: opt nat;
   recipient: principal;
   refundTo: opt principal;
 };
type Config = 
 record {
   admin: principal;
   icpFee: nat;
   icpIsToken0: bool;
   icpLedger: principal;
   maxImpactBps: nat;
   maxOrderIcp: nat;
   minOrderIcp: nat;
   nakFee: nat;
   nakLedger: principal;
   operators: vec principal;
   orderTtlSeconds: nat;
   paused: bool;
   pool: principal;
   slippageBps: nat;
 };
service : (init: Config, tickSeconds: nat) -> Router
