type Status = 
 variant {
   awaitingDeposit;
   completed: record {
                block: nat;
                icpIn: nat;
                nakOut: nat;
              };
   expired;
   needsReview: text;
   payoutPending: record {
                    createdAtTime: nat64;
                    icpIn: nat;
                    nakAmount: nat;
                  };
   refundPending:
    record {
      createdAtTime: nat64;
      fromDeposit: bool;
      icpAmount: nat;
      reason: RefundReason;
    };
   refunded: record {
               block: nat;
               icpAmount: nat;
               reason: RefundReason;
             };
   swapping: record {
               icpIn: nat;
               startedAt: int;
             };
 };
type Router = 
 service {
   activeOrderIds: () -> (vec nat) query;
   attachHoudini: (id: nat, houdiniId: text) -> (bool);
   createOrder: (args: CreateOrderArgs) -> (Result_2);
   feeStatus: () -> (FeeStatus) query;
   forcePayout: (id: nat, nakAmount: nat) -> (opt Status);
   forceRefund: (id: nat, icpAmount: nat, fromDeposit: bool) -> (opt Status);
   getConfig: () -> (Config) query;
   getOrder: (id: nat) -> (opt OrderView) query;
   health: () -> (Health) query;
   listOrders: (fromId: nat, limit: nat) -> (vec OrderView) query;
   poke: (id: nat) -> (PokeResult);
   poolUnusedBalance: () -> (Result_1);
   recoverDeposit: (id: nat, to: principal) -> (Result);
   reopen: (id: nat) -> (opt Status);
   resolveStuckFees: (delivered: bool) -> (bool);
   setConfig: (cfg: Config) -> (bool);
   setFee: (bps: nat, to: principal) -> (bool);
   setPaused: (paused: bool) -> (bool);
   sweepFees: () -> (nat);
   withdrawFromPool: (icpToken: bool, amount: nat) -> (Result);
 };
type Result_2 = 
 variant {
   err: CreateOrderError;
   ok: OrderView;
 };
type Result_1 = 
 variant {
   err: text;
   ok: record {
         icp: nat;
         nak: nat;
       };
 };
type Result = 
 variant {
   err: text;
   ok: nat;
 };
type RefundReason = 
 variant {
   admin;
   priceImpact: record {bps: nat;};
   swapFailed: text;
   tooLarge;
   tooSmall;
 };
type PokeResult = 
 variant {
   busy;
   notAuthorized;
   notFound;
   processed: Status;
   tooSoon;
 };
type OrderView = 
 record {
   createdAt: int;
   depositAccountId: text;
   depositSubaccount: blob;
   houdiniId: opt text;
   id: nat;
   minNakOut: nat;
   recipient: principal;
   refundTo: principal;
   status: Status;
 };
type Health = 
 record {
   acceptingOrders: bool;
   activeOrders: nat;
   cycles: nat;
   feeBps: nat;
   lowCyclesThreshold: nat;
   nextOrderId: nat;
   paused: bool;
 };
type FeeSweep = 
 record {
   amount: nat;
   createdAtTime: nat64;
   gross: nat;
   to: principal;
 };
type FeeStatus = 
 record {
   accrued: nat;
   autoSweepAt: nat;
   bps: nat;
   paidTotal: nat;
   pending: opt FeeSweep;
   stuck: nat;
   to: principal;
 };
type CreateOrderError = 
 variant {
   anonymousRecipient;
   invalidRecipient;
   notAuthorized;
   paused;
   tooManyOpenOrders;
 };
type CreateOrderArgs = 
 record {
   minNakOut: opt nat;
   recipient: principal;
   refundTo: opt principal;
 };
type Config = 
 record {
   admin: principal;
   icpFee: nat;
   icpIsToken0: bool;
   icpLedger: principal;
   maxImpactBps: nat;
   maxOrderIcp: nat;
   minOrderIcp: nat;
   nakFee: nat;
   nakLedger: principal;
   operators: vec principal;
   orderTtlSeconds: nat;
   paused: bool;
   pool: principal;
   slippageBps: nat;
 };
service : (init: Config, tickSeconds: nat) -> Router
