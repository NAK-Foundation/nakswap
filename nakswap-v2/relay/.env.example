# Houdini partner API (https://app.houdiniswap.com/partner/dashboard). Server-side only.
HOUDINI_API_KEY=
HOUDINI_API_SECRET=

# live = real Houdini (default when IC_HOST is mainnet); mock = simulated, local replica only
HOUDINI_MODE=live
IC_HOST=https://icp-api.io

# NAKSwap router canister on mainnet. Leave empty until it is deployed: the page still
# serves live quotes, and swaps stay disabled.
ROUTER_CANISTER_ID=

# 32-byte hex seed for the relay's signing identity. Its principal must be in the router's
# `operators` (the server prints it on start).
RELAY_IDENTITY_SEED=

PORT=8787
